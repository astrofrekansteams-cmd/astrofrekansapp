{
  "//": [
    "Firebase project configuration for Astrofrekans.",
    "",
    "The rules files here are the real, deployed sources - not examples. None of",
    "them contains a permissive fallback.",
    "",
    "The emulator block lets rules and integration tests run without a live",
    "project or a service account. Ports are fixed so a test suite can rely on",
    "them."
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "database": { "port": 9000 },
    "storage": { "port": 9199 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
