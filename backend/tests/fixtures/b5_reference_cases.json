      }
    }
  ],
  "davison_pair": {
    "verified_independently": false,
    "verification_note": "The midpoint instant and coordinates below follow from the two charts above by arithmetic that IS independently checkable (see utc_midpoints and geographic_midpoints); the resulting chart positions are engine output.",
