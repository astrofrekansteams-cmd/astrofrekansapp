# Copy to .env and fill in. NEVER commit the real .env.

# --- app ---------------------------------------------------------------
ENVIRONMENT=local            # local | test | staging | production
DEBUG=true
APP_NAME=Astrofrekans API

# --- database ----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://astro:astro@localhost:5432/astrofrekans
POSTGRES_USER=astro
POSTGRES_PASSWORD=astro
POSTGRES_DB=astrofrekans
POSTGRES_PORT=5432
DB_ECHO=false

# --- redis -------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --- security ----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-with-a-random-48-byte-value
JWT_REFRESH_SECRET=change-me-with-a-different-random-value
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
# The emailed link (the token is appended as #token=). A hosted https page
# that hands the token to the app: astrofrekans://app/reset-password?token=...
# Production requires https.
PASSWORD_RESET_URL_BASE=https://astrofrekansteams-cmd.github.io/astrofrekansapp/reset-password.html

# --- mail (password reset) ----------------------------------------------
# disabled (default): /auth/forgot-password answers 503
#   password_reset_unavailable - nothing is claimed as sent.
# smtp: any SMTP relay; needs SMTP_HOST and MAIL_FROM (+ credentials).
# log: local development only (link written to the log). memory: tests only.
# disabled/log/memory are refused in production (hybrid auth needs local reset).
MAIL_PROVIDER=disabled
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=10
# Retries transient failures only (connection, timeout, 4xx).
SMTP_MAX_ATTEMPTS=3

# Comma separated. Leave EMPTY for a mobile-only deployment; add only trusted
# browser origins if you serve a web client. Never use "*" in production.
CORS_ORIGINS=

# --- rate limiting -----------------------------------------------------
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10/minute
REGISTER_RATE_LIMIT=5/minute
AI_RATE_LIMIT=30/hour

# --- astrology ---------------------------------------------------------
EPHEMERIS_PATH=data/ephemeris/de421.bsp
DEFAULT_HOUSE_SYSTEM=placidus

# --- geocoding ---------------------------------------------------------
GEOCODING_PROVIDER=mock      # mock | nominatim
NOMINATIM_USER_AGENT=astrofrekans-backend (contact@example.com)

# --- AI (backend only - never ship these to the mobile app) ------------
# openai = the real provider; fake = the deterministic test double, which is
# refused in production. Without OPENAI_API_KEY the app still boots and the AI
# endpoints answer ai_not_configured.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORGANIZATION=
ANTHROPIC_API_KEY=

# Model routing per tier. Verify these ids against the provider's current
# model list before going live - they are configuration, not guarantees.
AI_MODEL_LOW_COST=gpt-5.6-luna
AI_MODEL_STANDARD=gpt-5.6-terra
AI_MODEL_PREMIUM=gpt-5.6-sol

# Optional per-use-case overrides; leave empty to use the tier.
AI_MODEL_CHAT=
AI_MODEL_REPORT=
AI_MODEL_SUMMARY=

AI_REQUEST_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
AI_CHAT_RATE_LIMIT=40/hour
AI_REPORT_RATE_LIMIT=10/hour
AI_STREAM_RATE_LIMIT=40/hour
AI_LOG_PROMPTS=false

# Fallback policy. Chat and summaries may be served by a cheaper model when
# the requested one is unavailable; a premium report may not, because a
# quietly downgraded report is worse than an honest error.
AI_ALLOW_MODEL_FALLBACK=true
AI_ALLOW_FALLBACK_CHAT=true
AI_ALLOW_FALLBACK_SUMMARY=true
AI_ALLOW_FALLBACK_REPORT=false

# Expert marketplace.
# Commission is basis points and never a literal in business logic.
# 10000 bp = 100%. The split is integer arithmetic and rounding favours the
# expert: the platform fee truncates, the remainder is theirs.
MARKETPLACE_COMMISSION_BPS=2000
MARKETPLACE_DEFAULT_CURRENCY=TRY

# Slot generation policy. All of these are policy rather than physics, so
# they are settings rather than constants inside the generator.
APPOINTMENT_SLOT_GRANULARITY_MINUTES=15
APPOINTMENT_BUFFER_BEFORE_MINUTES=5
APPOINTMENT_BUFFER_AFTER_MINUTES=5
APPOINTMENT_MINIMUM_NOTICE_MINUTES=120
APPOINTMENT_MAX_HORIZON_DAYS=90
APPOINTMENT_MAX_SLOT_QUERY_DAYS=92

# How long a slot stays claimed while an order is placed. Long enough to
# finish a checkout, short enough that an abandoned form does not hold a
# popular slot hostage.
SLOT_HOLD_TTL_SECONDS=600

# Separate buckets: reads are cheap, writes that hold real time are not.
MARKETPLACE_SEARCH_RATE_LIMIT=120/hour
APPOINTMENT_BOOKING_RATE_LIMIT=20/hour
ORDER_CREATE_RATE_LIMIT=30/hour
REVIEW_CREATE_RATE_LIMIT=10/hour
EXPERT_MUTATION_RATE_LIMIT=60/hour

# Divination (tarot / rune / katina).
# Reversal is a deck property first: Katina cards and symmetrical runes are
# never reversed whatever these say.
DIVINATION_REVERSAL_ENABLED=true
DIVINATION_REVERSAL_PROBABILITY=0.3
DIVINATION_INCLUDE_BLANK_RUNE=false
# Drawing is cheap; interpreting costs a model call.
DIVINATION_DRAW_RATE_LIMIT=60/hour
DIVINATION_INTERPRET_RATE_LIMIT=20/hour
# The same question on the same deck inside this window is flagged as a
# repeat. Never blocked.
DIVINATION_REPEAT_WINDOW_SECONDS=21600

# Report worker (python -m app.workers.ai_report_worker).
# The lease must outlast the slowest generation, or a healthy worker's job
# would be recovered out from under it.
AI_JOB_LEASE_SECONDS=600
AI_JOB_MAX_ATTEMPTS=3
AI_WORKER_POLL_SECONDS=2.0
AI_WORKER_IDLE_LOG_SECONDS=300

# --- firebase ----------------------------------------------------------
#
# PLACEHOLDERS. A real service-account key never goes in this file and never
# goes in the repository. Provide it through the deployment's secret store.
#
# Without these the backend still boots and everything that is not Firebase
# keeps working: chat, presence, attachments and push answer
# `firebase_not_configured` (503) and nothing else changes.
FIREBASE_PROJECT_ID=
# One of the two. JSON is the whole service-account document as a single line,
# which is what a secret store hands you; PATH points at a mounted file.
FIREBASE_CREDENTIALS_JSON=
# Host runs: a path on this machine, e.g. backend/secrets/firebase-admin.json
# (the secrets/ folder is gitignored and excluded from the Docker context).
FIREBASE_CREDENTIALS_PATH=
# Containers: docker-compose mounts ./secrets read-only at /run/secrets and
# passes this value as the container's FIREBASE_CREDENTIALS_PATH, e.g.
# /run/secrets/firebase-admin.json. Leave empty when using the JSON variable.
FIREBASE_CONTAINER_CREDENTIALS_PATH=
FIREBASE_STORAGE_BUCKET=
FIREBASE_DATABASE_URL=

# "firebase" is the real SDK. "fake" is the in-memory test double and is
# refused in production by assert_production_ready.
FIREBASE_PROVIDER=firebase

# Local development against the Firebase Emulator Suite. Empty means the real
# project.
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=
FIREBASE_DATABASE_EMULATOR_HOST=
FIREBASE_STORAGE_EMULATOR_HOST=

# --- authentication mode -----------------------------------------------
#
# `hybrid` accepts both the backend's own JWTs and Firebase ID tokens, so
# existing accounts keep working while clients migrate. Switching straight to
# `firebase` signs out every current user.
AUTH_MODE=hybrid

# Checking revocation costs a round trip to Firebase on every request. An ID
# token lives an hour, so this is off by default.
FIREBASE_CHECK_REVOKED=false
FIREBASE_TOKEN_CLOCK_SKEW_SECONDS=5

# Adopting an existing local account because a Firebase token carries a
# matching email address is an account-takeover primitive. Leave this off; the
# safe path is to sign in and link from inside the session.
FIREBASE_AUTO_LINK_VERIFIED_EMAIL=false

# --- chat --------------------------------------------------------------
CHAT_MESSAGE_MAX_LENGTH=4000
CHAT_HISTORY_PAGE_SIZE=50
# A completed consultation stays writable this long, then becomes read-only.
# History is never withdrawn.
CHAT_READ_ONLY_AFTER_COMPLETION_DAYS=30
CHAT_ATTACHMENTS_PER_MESSAGE=4

# --- attachments -------------------------------------------------------
# SVG, HTML and executables are refused whatever this list says.
ATTACHMENT_MAX_BYTES=8388608
ATTACHMENT_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
ATTACHMENT_PENDING_TTL_SECONDS=1800

# --- push (python -m app.workers.notification_worker) ------------------
PUSH_OUTBOX_MAX_ATTEMPTS=5
PUSH_OUTBOX_LEASE_SECONDS=120
PUSH_WORKER_POLL_SECONDS=2.0
PUSH_WORKER_IDLE_LOG_SECONDS=300
PUSH_NOTIFY_SENDER_OTHER_DEVICES=false

# --- iOS incoming calls: APNs PushKit VoIP (token-based auth, .p8) --------
# Placeholders only. The .p8 key comes from a secret store, never git.
APNS_PROVIDER=apns
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_PRIVATE_KEY_PATH=
APNS_BUNDLE_ID=
# production (TestFlight/App Store) or sandbox (development builds).
APNS_ENVIRONMENT=production
# apns-expiration for VoIP, seconds from now. Apple: 0 or a few seconds.
APNS_VOIP_EXPIRATION_SECONDS=0
APNS_TIMEOUT_SECONDS=8

# --- call push timing (checked at startup) ------------------------------
# CALL_PUSH_SEND_TIMEOUT_SECONDS + 2 <= CALL_PUSH_LEASE_SECONDS < CALL_RING_TIMEOUT_SECONDS
# and APNS_TIMEOUT_SECONDS <= CALL_PUSH_SEND_TIMEOUT_SECONDS. A violation refuses to boot.
# The lease is how long a claimed call push belongs to one worker: a worker
# that dies is taken over after it, while the phone can still ring.
CALL_PUSH_LEASE_SECONDS=15
CALL_PUSH_SEND_TIMEOUT_SECONDS=8

FIREBASE_AUTH_BOOTSTRAP_RATE_LIMIT=30/hour
CONVERSATION_CREATE_RATE_LIMIT=20/hour
MESSAGE_SEND_RATE_LIMIT=120/hour
ATTACHMENT_CREATE_RATE_LIMIT=60/hour
DEVICE_REGISTER_RATE_LIMIT=30/hour

# --- calls (LiveKit) ----------------------------------------------------
#
# PLACEHOLDERS. The API secret signs join tokens and verifies webhooks; it
# never goes in this file, in the repository, in a log or to a client.
#
# Without these the backend still boots: call endpoints answer
# `call_provider_not_configured` (503) and nothing else changes.
LIVEKIT_URL=
# Where the backend reaches the LiveKit server API, if not LIVEKIT_URL (for
# example inside a compose network). ws(s):// is fine; the SDK converts it.
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# "livekit" is the real SDK. "fake" is the in-memory test double and is
# refused in production by assert_production_ready.
REALTIME_PROVIDER=livekit

# A join token authorises connecting, not the call: LiveKit checks it only on
# the initial connection and refreshes it for connected clients.
CALL_TOKEN_TTL_SECONDS=600
# Join window: from EARLY before the appointment's start to LATE after its end.
CALL_JOIN_EARLY_SECONDS=600
CALL_JOIN_LATE_SECONDS=900
CALL_RING_TIMEOUT_SECONDS=60
CALL_RECONNECT_GRACE_SECONDS=45
CALL_MAX_DURATION_SECONDS=10800
CALL_ROOM_EMPTY_TIMEOUT_SECONDS=300
CALL_RECONCILE_INTERVAL_SECONDS=30
CALL_WORKER_POLL_SECONDS=5.0

CALL_CREATE_RATE_LIMIT=20/hour
CALL_JOIN_TOKEN_RATE_LIMIT=60/hour
CALL_END_RATE_LIMIT=30/hour
LIVEKIT_WEBHOOK_RATE_LIMIT=600/minute

# --- payments: App Store ----------------------------------------------------
#
# PLACEHOLDERS. The .p8 private key signs App Store Server API requests; it
# never goes in this file or the repository. Without these the backend boots
# and Apple verification answers `store_provider_not_configured`.
APPLE_BUNDLE_ID=
# Numeric App Apple ID - required by Apple's library for production data.
APPLE_APP_APPLE_ID=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_PATH=
# Production or Sandbox. Xcode/LocalTesting are refused: Apple's library skips
# signature verification in them.
APPLE_ENVIRONMENT=Production
# Directory with Apple's root certificates (.cer) from
# https://www.apple.com/certificateauthority/ - downloaded by the operator.
APPLE_ROOT_CERTIFICATES_PATH=
APPLE_ENABLE_ONLINE_CHECKS=true
# App Review buys in the sandbox against production builds. Off by default.
APPLE_ACCEPT_SANDBOX_IN_PRODUCTION=false

# --- payments: Google Play -------------------------------------------------
GOOGLE_PLAY_PACKAGE_NAME=
# One of the two. Never commit the service-account JSON.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_SERVICE_ACCOUNT_PATH=
# RTDN: the Pub/Sub push subscription's audience and its signing account.
GOOGLE_PUBSUB_PUSH_AUDIENCE=
GOOGLE_PUBSUB_PUSH_SERVICE_ACCOUNT=
GOOGLE_ACCEPT_TEST_PURCHASES_IN_PRODUCTION=false

# "real" or "fake" (test double, refused in production).
STORE_PROVIDER=real
# Store product ids per catalogue code, as JSON. A code without an id is not
# sold on that store. Exactly seven products are sold:
#   premium_monthly, premium_yearly, cosmic_plus_monthly, cosmic_plus_yearly
#   (subscriptions) and coins_120, coins_350, coins_800 (consumables).
# The legacy natal_report, synastry_report, annual_forecast_report and
# ai_pre_analysis are never sold in the stores; production refuses an id for
# them, an empty value, and a missing id on a store the server verifies.
# Google Play: one subscription product per code (one base plan each).
# Example shape (not real ids):
#   {"premium_monthly": {"apple": "com.astrofrekans.premium.monthly", "google": "premium_monthly"}}
STORE_PRODUCT_IDS=

# --- payments: external marketplace (live 1:1 sessions only) --------------
# No provider has been chosen. "disabled" answers
# external_payment_provider_not_configured; "fake" is test-only.
EXTERNAL_PAYMENT_PROVIDER=disabled
EXTERNAL_PAYMENT_INTENT_TTL_SECONDS=1800

# --- settlement ---------------------------------------------------------------
# Days after completion before an expert's share is available. A business
# decision: leave empty and nothing is released automatically.
EXPERT_SETTLEMENT_HOLD_DAYS=
PREMIUM_DURING_GRACE_PERIOD=true
# Premium includes the credit-sold reports (natal/synastry/yearly). Product decision; off = credit required.
PAID_REPORTS_INCLUDED_IN_PREMIUM=false
# Server-side premium gating (app/services/features.py). Must be true in
# production; a local environment without store products may set false.
PREMIUM_GATING_ENABLED=true
# Premium quotas. Empty = same as free until the product decides.
AI_CHAT_RATE_LIMIT_PREMIUM=
AI_REPORT_RATE_LIMIT_PREMIUM=

BILLING_VERIFY_RATE_LIMIT=30/hour
BILLING_RECONCILE_RATE_LIMIT=10/hour
EXTERNAL_PAYMENT_CREATE_RATE_LIMIT=10/hour
REFUND_REQUEST_RATE_LIMIT=5/hour
STORE_WEBHOOK_RATE_LIMIT=600/minute

# --- ports -------------------------------------------------------------
API_PORT=8000
