<?xml version="1.0" encoding="utf-8"?>
<!-- Auth tokens and birth data live in the encrypted store; never back them up
     or transfer them to another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
